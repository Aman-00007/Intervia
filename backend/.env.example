# Environment
APP_ENV=development
APP_NAME=Intervia

# PostgreSQL Dual-Schema Connections
DATABASE_VAULT_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervia_db
DATABASE_OPS_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervia_db

# Redis (HMAC Seeds & Real-Time Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO / Nebius Object Storage (Offline Black Box Video Chunks)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=intervia-blackbox

# Judge0 / Piston Sandboxed Code Runner
CODE_RUNNER_URL=http://localhost:2000/api/v2/execute

# Cryptographic Keys (Generate fresh 32-byte hex for production)
AES_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=intervia-super-secret-jwt-key-2026

# Nebius Token Factory (NVIDIA Nemotron 3 Models)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEBIUS_MODEL_NANO=nvidia/Nemotron-3-Nano-30B
NEBIUS_MODEL_SUPER=nvidia/Nemotron-3-Super-120B
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550B